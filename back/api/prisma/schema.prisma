generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id         Int      @id @default(autoincrement())
  nome       String
  capacidade Int
  local      String
  descricao  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
