generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Room{
  id Int @id @default(autoincrement())
  nome String
  capacidade Int
  local String
  descricao String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
