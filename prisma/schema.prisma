datasource db {   
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Room {
  id         String @id @default(uuid())
  nome       String
  capacidade Int
  local  String
  descricao String

 reserva Reserva[]

  @@map("rooms")
}

model User {
  id       String @id @default(uuid())
  nome     String
  email    String @unique
  password String

  reserva Reserva[]
 }

model Reserva {
  id  String @id @default(uuid())
  data DateTime

  userId    String
  roomId    String

  user      User @relation(fields: [userId], references: [id])
  room      Room @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())

  @@map("reserva")
}