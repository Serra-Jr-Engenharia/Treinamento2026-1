generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Room {
  id         String  @id @default(uuid())
  name       String @unique
  capacidade Int
  local      String
  descricao  String?
  reservations Reservation[]

  @@map("rooms")
}

model RoomLog {
  id        String   @id @default(uuid())
  roomId    String
  action    String
  changes   Json
  timestamp DateTime @default(now())

  @@map("room_logs")
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  reservations Reservation[]

  @@map("users")
}

model Reservation {
  id String @id @default(uuid())
  roomId String 
  userId String
  startTime DateTime
  endTime DateTime
  createdAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reservations")
}