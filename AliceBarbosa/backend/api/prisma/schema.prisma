generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") 
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  criado_em     DateTime @default(now())
}

model Room {
  id            String   @id @default(uuid())
  nome          String
  capacidade    Int
  local         String   
  descricao     String   
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt
}