generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "mysql"
}

model Room {
  id           String        @id @default(uuid())
  nome         String
  capacidade   Int
  local        String
  descricao    String
  reservations Reservation[]
}

model User {
  id           String        @id @default(uuid())
  nome         String
  email        String        @unique
  password     String
  reservations Reservation[]
}

model Reservation {
  id       String   @id @default(uuid())
  dataHora DateTime
  userId   String
  roomId   String

  user User @relation(fields: [userId], references: [id])
  room Room @relation(fields: [roomId], references: [id])
}
