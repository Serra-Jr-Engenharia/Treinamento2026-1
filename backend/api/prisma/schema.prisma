generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Room {
  id         Int      @id @default(autoincrement())
  nome       String
  capacidade Int
  local      String
  descricao  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
}
